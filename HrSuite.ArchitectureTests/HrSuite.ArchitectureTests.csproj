<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HrSuite.Core\HrSuite.Core.csproj" />
    <ProjectReference Include="..\HrSuite.Common\HrSuite.Common.csproj" />
    <ProjectReference Include="..\HrSuite.Infrastructure\HrSuite.Infrastructure.csproj" />
    <ProjectReference Include="..\HrSuite.Configuration\HrSuite.Configuration.csproj" />
    <ProjectReference Include="..\HrSuite.API\HrSuite.API.csproj" />
    <ProjectReference Include="..\HrSuite.Addons.Payroll\HrSuite.Addons.Payroll.csproj" />
    <ProjectReference Include="..\HrSuite.Integrations.Email\HrSuite.Integrations.Email.csproj" />
    <ProjectReference Include="..\HrSuite.Extensions.Engine\HrSuite.Extensions.Engine.csproj" />
  </ItemGroup>

  <!--
    Section 3.2: the dependency rule must fail the BUILD, not merely a test report.
    The "no build" switch below is what stops this recursing, and the
    EnforceArchitecture property is the escape hatch for tooling that needs a bare compile.
  -->
  <Target Name="EnforceArchitecture"
          AfterTargets="Build"
          Condition="'$(EnforceArchitecture)' != 'false' AND '$(DesignTimeBuild)' != 'true'">
    <Exec Command="dotnet test &quot;$(MSBuildProjectFullPath)&quot; --no-build --nologo --verbosity quiet -p:EnforceArchitecture=false"
          ContinueOnError="false"
          StandardOutputImportance="high" />
  </Target>

</Project>
